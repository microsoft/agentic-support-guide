{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agents/data-analyst/output.schema.json",
  "title": "Data Analyst Agent output",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "analysis"],
  "properties": {
    "contract_version": { "const": "1.0.0" },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "detected_need",
        "evidence_bullets",
        "missing_data_flags",
        "analysis_confidence"
      ],
      "properties": {
        "detected_need": { "type": "string", "maxLength": 500 },
        "evidence_bullets": {
          "type": "array",
          "maxItems": 12,
          "items": { "type": "string", "minLength": 1, "maxLength": 300 }
        },
        "missing_data_flags": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "string", "minLength": 1, "maxLength": 300 }
        },
        "analysis_confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
