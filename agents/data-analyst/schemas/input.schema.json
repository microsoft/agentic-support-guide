{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agents/data-analyst/input.schema.json",
  "title": "Data Analyst Agent input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "category", "dealership_context", "concern_text"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "category": {
      "type": "string",
      "enum": [
        "lead-response",
        "test-drive-conversion",
        "listing-completeness",
        "inventory-ageing",
        "price-data-freshness",
        "multi-area"
      ]
    },
    "dealership_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dealership_label", "region_id", "segment"],
      "properties": {
        "dealership_label": { "type": "string", "maxLength": 40 },
        "region_id": { "type": "string", "maxLength": 20 },
        "segment": { "type": "string", "maxLength": 20 },
        "process_score": { "type": "number", "minimum": 0, "maximum": 100 },
        "appointment_attendance_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "followup_index": { "type": "number", "minimum": 0, "maximum": 100 },
        "engagement_index": { "type": "number", "minimum": 0, "maximum": 100 },
        "score_periods": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$" },
          "maxItems": 24
        },
        "score_by_process_area": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
            "maxItems": 24
          }
        },
        "latest_band_by_process_area": {
          "type": "object",
          "additionalProperties": { "type": "string", "maxLength": 20 }
        },
        "area_score_count": { "type": "integer", "minimum": 0 },
        "duplicate_area_records": { "type": "integer", "minimum": 0 },
        "operations_periods": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$" },
          "maxItems": 24
        },
        "appointment_attendance_rate_by_period": {
          "type": "array",
          "items": { "type": "number", "minimum": 0, "maximum": 1 },
          "maxItems": 24
        },
        "escalations_by_period": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 },
          "maxItems": 24
        },
        "followup_completion_by_period": {
          "type": "array",
          "items": { "type": "number", "minimum": 0, "maximum": 100 },
          "maxItems": 24
        },
        "operations_record_count": { "type": "integer", "minimum": 0 }
      }
    },
    "concern_text": { "type": "string", "maxLength": 1000 }
  }
}
