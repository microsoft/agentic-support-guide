{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agents/validator/output.schema.json",
  "title": "Validator Agent output (advisory critique only)",
  "description": "What the remote model returns. Pass/fail and issue codes are decided by deterministic Python, never by the model, so they are deliberately absent here.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "warning_codes",
    "repair_guidance"
  ],
  "properties": {
    "warning_codes": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]{3,59}$"
      }
    },
    "repair_guidance": { "type": "string", "maxLength": 1000 }
  }
}
