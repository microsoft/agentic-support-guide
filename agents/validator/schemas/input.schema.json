{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agents/validator/input.schema.json",
  "title": "Validator Agent input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "analyst_output",
    "recommendation_draft",
    "allowed_resource_ids",
    "allowed_goal_ids",
    "allowed_strategy_ids",
    "required_contract_version"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "analyst_output": {
      "$ref": "../../data-analyst/schemas/output.schema.json"
    },
    "recommendation_draft": {
      "$ref": "../../support-recommender/schemas/output.schema.json"
    },
    "allowed_resource_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 60 }
    },
    "allowed_goal_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 60 }
    },
    "allowed_strategy_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 60 }
    },
    "required_contract_version": { "type": "string", "maxLength": 20 }
  }
}
