{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/contracts/v1/data-analysis-result.schema.json",
  "title": "Data Analyst Agent -> downstream result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "message_id",
    "trace_id",
    "created_at",
    "source_agent",
    "payload"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "message_id": { "type": "string", "format": "uuid" },
    "trace_id": { "type": "string", "format": "uuid" },
    "created_at": { "type": "string", "format": "date-time" },
    "source_agent": { "const": "data-analyst-agent" },
    "target_agent": {
      "type": "string",
      "enum": ["support-recommendation-agent", "validator-agent", "coordinator"]
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dealer_group_id", "detected_need", "evidence_bullets", "missing_data_flags", "analysis_confidence"],
      "properties": {
        "dealer_group_id": {
          "type": "string",
          "minLength": 2,
          "maxLength": 32,
          "pattern": "^[A-Z0-9][A-Z0-9\\-]{1,31}$"
        },
        "detected_need": { "type": "string", "maxLength": 300 },
        "evidence_bullets": {
          "type": "array",
          "maxItems": 12,
          "items": { "type": "string", "minLength": 1, "maxLength": 300 }
        },
        "missing_data_flags": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "string", "minLength": 1, "maxLength": 300 }
        },
        "analysis_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "citations": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["citation_id", "dealer_group_id", "source_type", "source_title", "evidence_summary", "source_ref", "retrieved_at", "confidence"],
            "properties": {
              "citation_id": { "type": "string", "minLength": 1, "maxLength": 64 },
              "dealer_group_id": { "type": "string", "minLength": 2, "maxLength": 32, "pattern": "^[A-Z0-9][A-Z0-9\\-]{1,31}$" },
              "source_type": { "type": "string", "enum": ["structured_data", "document", "policy", "resource", "synthetic_fixture"] },
              "source_title": { "type": "string", "minLength": 1, "maxLength": 200 },
              "section_or_page": { "type": "string", "maxLength": 80 },
              "evidence_summary": { "type": "string", "minLength": 1, "maxLength": 500 },
              "source_ref": { "type": "string", "minLength": 1, "maxLength": 200 },
              "retrieved_at": { "type": "string", "minLength": 1, "maxLength": 32 },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        },
        "synthetic_only": { "const": true }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "spec_version": { "type": "string", "maxLength": 20 },
        "latency_ms": { "type": "integer", "minimum": 0 },
        "token_estimate": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
