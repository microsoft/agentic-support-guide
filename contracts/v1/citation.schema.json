{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/contracts/v1/citation.schema.json",
  "title": "Citation - dealer group-scoped evidence pointer",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "citation_id",
    "dealer_group_id",
    "source_type",
    "source_title",
    "evidence_summary",
    "source_ref",
    "retrieved_at",
    "confidence"
  ],
  "properties": {
    "citation_id": { "type": "string", "minLength": 1, "maxLength": 64 },
    "dealer_group_id": {
      "type": "string",
      "minLength": 2,
      "maxLength": 32,
      "pattern": "^[A-Z0-9][A-Z0-9\\-]{1,31}$"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "structured_data",
        "document",
        "policy",
        "resource",
        "synthetic_fixture"
      ]
    },
    "source_title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "section_or_page": { "type": "string", "maxLength": 80 },
    "evidence_summary": { "type": "string", "minLength": 1, "maxLength": 500 },
    "source_ref": { "type": "string", "minLength": 1, "maxLength": 200 },
    "retrieved_at": { "type": "string", "minLength": 1, "maxLength": 32 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
