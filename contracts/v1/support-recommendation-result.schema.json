{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/contracts/v1/support-recommendation-result.schema.json",
  "title": "Support Recommendation Agent -> downstream result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "message_id",
    "trace_id",
    "created_at",
    "source_agent",
    "payload"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "message_id": { "type": "string", "format": "uuid" },
    "trace_id": { "type": "string", "format": "uuid" },
    "created_at": { "type": "string", "format": "date-time" },
    "source_agent": { "const": "support-recommendation-agent" },
    "target_agent": {
      "type": "string",
      "enum": ["validator-agent", "coordinator"]
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "district_id",
        "detected_need",
        "support_tier",
        "recommended_frequency",
        "grouping_guidance",
        "resource_ids",
        "rationale",
        "smart_goal_suggestions",
        "strategy_suggestions",
        "educator_next_steps",
        "progress_monitoring",
        "review_window_days",
        "decision_rule",
        "caveats",
        "citations",
        "synthetic_only"
      ],
      "properties": {
        "district_id": {
          "type": "string",
          "minLength": 2,
          "maxLength": 32,
          "pattern": "^[A-Z0-9][A-Z0-9\\-]{1,31}$"
        },
        "detected_need": { "type": "string", "maxLength": 500 },
        "support_tier": {
          "type": "string",
          "maxLength": 500,
          "description": "Must contain one of: universal, targeted, intensive, enrichment."
        },
        "recommended_frequency": { "type": "string", "maxLength": 500 },
        "grouping_guidance": { "type": "string", "maxLength": 500 },
        "resource_ids": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "string", "minLength": 1, "maxLength": 60 }
        },
        "rationale": { "type": "string", "maxLength": 2000 },
        "smart_goal_suggestions": {
          "type": "array",
          "maxItems": 6,
          "items": { "type": "string", "minLength": 1, "maxLength": 60 }
        },
        "strategy_suggestions": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "string", "minLength": 1, "maxLength": 60 }
        },
        "educator_next_steps": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "string", "minLength": 1, "maxLength": 300 }
        },
        "progress_monitoring": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "string", "minLength": 1, "maxLength": 300 }
        },
        "review_window_days": { "type": "integer", "minimum": 7, "maximum": 180 },
        "decision_rule": { "type": "string", "maxLength": 500 },
        "caveats": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "string", "minLength": 1, "maxLength": 300 }
        },
        "citations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["citation_id", "district_id", "source_type", "source_title", "evidence_summary", "source_ref", "retrieved_at", "confidence"],
            "properties": {
              "citation_id": { "type": "string", "minLength": 1, "maxLength": 64 },
              "district_id": { "type": "string", "minLength": 2, "maxLength": 32, "pattern": "^[A-Z0-9][A-Z0-9\\-]{1,31}$" },
              "source_type": { "type": "string", "enum": ["structured_data", "document", "policy", "resource", "synthetic_fixture"] },
              "source_title": { "type": "string", "minLength": 1, "maxLength": 200 },
              "section_or_page": { "type": "string", "maxLength": 80 },
              "evidence_summary": { "type": "string", "minLength": 1, "maxLength": 500 },
              "source_ref": { "type": "string", "minLength": 1, "maxLength": 200 },
              "retrieved_at": { "type": "string", "minLength": 1, "maxLength": 32 },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        },
        "synthetic_only": { "const": true }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
