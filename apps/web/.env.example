VITE_API_BASE_URL=/api

# Entra sign-in. Leave all three empty for local development against a
# backend started with API_AUTH_MODE=disabled; the UI then skips sign-in.
# Setting only some of them produces a redirect loop, so it is treated the
# same as setting none.
#   VITE_ENTRA_CLIENT_ID  = terraform output -raw api_client_id
#   VITE_ENTRA_TENANT_ID  = az account show --query tenantId -o tsv
#   VITE_API_SCOPE        = terraform output -raw api_scope
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_TENANT_ID=
VITE_API_SCOPE=
