# Azure AI Foundry connection - populate from `terraform output` after apply.
# Do NOT commit real values. `.env` is gitignored.
AZURE_AI_FOUNDRY_ENDPOINT=
AZURE_AI_FOUNDRY_PROJECT_NAME=
AZURE_AI_FOUNDRY_DEPLOYMENT=
AZURE_AI_FOUNDRY_API_VERSION=2024-10-21
AZURE_AI_FOUNDRY_AUTH_MODE=entra

# Application Insights connection string (optional). If omitted, telemetry no-ops.
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Development-only. Enables POST /api/demo/reset. Never enable in production.
DEMO_RESET_ENABLED=false
