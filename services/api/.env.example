# Azure AI Foundry Agent Service connection - populate from `terraform output`
# after apply. Do NOT commit real values. `.env` is gitignored.

# Project endpoint (required). Format:
#   https://<resource>.services.ai.azure.com/api/projects/<project>
AZURE_AI_FOUNDRY_PROJECT_ENDPOINT=

# Per-role model deployment names (required). The API reads these at startup
# and the publish scripts use them. Values are the deployment name in the
# AI Services account (e.g. `asg-chat`).
FOUNDRY_MODEL_DEPLOYMENT_ANALYST=
FOUNDRY_MODEL_DEPLOYMENT_RECOMMENDER=
FOUNDRY_MODEL_DEPLOYMENT_VALIDATOR=

# Standalone workshop agent (Module 4). Not required by the coordinator.
FOUNDRY_MODEL_DEPLOYMENT_EXPLAINER=

# Learner suffix appended to published agent names so a shared Foundry
# project can host a whole workshop without collisions. Lowercase a-z0-9-.
WORKSHOP_LEARNER_SUFFIX=

# Only 'entra' (Microsoft Entra ID / DefaultAzureCredential) is supported.
AZURE_AI_FOUNDRY_AUTH_MODE=entra

# Evidence retrieval (Module 6). Leave as fixtures until you have provisioned
# a knowledge base; `populate-env.ps1` fills the rest in from Terraform.
EVIDENCE_SOURCE=fixtures
AZURE_SEARCH_ENDPOINT=
FOUNDRY_IQ_KNOWLEDGE_BASE=
FOUNDRY_IQ_KNOWLEDGE_SOURCE=

# Application Insights connection string (optional). If omitted, telemetry no-ops.
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Development-only. Enables POST /api/demo/reset. Never enable in production.
DEMO_RESET_ENABLED=false
