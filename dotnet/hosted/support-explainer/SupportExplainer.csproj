<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Foundry builds this project and starts it with `dotnet SupportExplainer.dll`.
         The build reads the target framework from this file to pick its .NET
         version, so it is stated here even though Directory.Build.props sets it. -->
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>SupportExplainer</AssemblyName>
    <RootNamespace>AgenticSupportGuide.Hosted</RootNamespace>
    <IsPackable>false</IsPackable>
    <ApiDir>$(MSBuildThisFileDirectory)..\..\services\api\AgenticSupportGuide.Api\</ApiDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI" />
    <PackageReference Include="Microsoft.Agents.AI.Foundry" />
    <PackageReference Include="Microsoft.Agents.AI.Foundry.Hosting" />
    <PackageReference Include="Azure.Identity" />
  </ItemGroup>

  <!--
    Shared with the API so the hosted agent cannot drift from the prompt blocks
    and determination policy the coordinator uses. In the repo they are linked
    from the API; the publish script copies them next to this file in the
    upload, where the default glob compiles them.

    This is a build-time snapshot, not a live dependency: a deployed agent
    keeps the policy it shipped with until it is published again. Tightening
    the policy therefore needs a re-publish, or the internet-facing copy stays
    on the old one.
  -->
  <ItemGroup Condition="Exists('$(ApiDir)')">
    <Compile Include="$(ApiDir)Agents\Shared\PromptBlocks.cs" Link="Shared\PromptBlocks.cs" />
    <Compile Include="$(ApiDir)Agents\Shared\Determinations.cs" Link="Shared\Determinations.cs" />
    <Compile Include="$(ApiDir)Parity\PyText.cs" Link="Shared\PyText.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Generated by the publish script from agents/support-explainer; never committed. -->
    <None Update="instructions.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
