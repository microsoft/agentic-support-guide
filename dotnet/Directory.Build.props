<Project>
  <!-- Every .NET project in this track, including the file-based scripts and samples. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- The app formats numbers and compares strings itself; no culture may change that. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- MAAI001: Agent Framework APIs marked experimental (workflows, hosting, evaluation).
         OPENAI001: OpenAI SDK types marked for evaluation (the Responses request options that turn storage off). -->
    <NoWarn>$(NoWarn);MAAI001;OPENAI001</NoWarn>
  </PropertyGroup>
</Project>
