<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <AssemblyName>AgenticSupportGuide.Api</AssemblyName>
    <RootNamespace>AgenticSupportGuide.Api</RootNamespace>
    <!-- App Service runs `dotnet AgenticSupportGuide.Api.dll` from the publish folder. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI" />
    <PackageReference Include="Microsoft.Agents.AI.Workflows" />
    <PackageReference Include="Microsoft.Agents.AI.Foundry" />
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Azure.Search.Documents" />
    <PackageReference Include="Azure.Monitor.OpenTelemetry.Exporter" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The agent definitions are shared by both tracks and live at the repo
      root. They ship next to the app, so the published folder is
      self-contained and a prompt edit takes effect on the next build.
    -->
    <Content Include="..\..\..\..\agents\**\*.md;..\..\..\..\agents\**\*.yaml;..\..\..\..\agents\**\*.json"
             Exclude="..\..\..\..\agents\**\tests\**"
             LinkBase="agents"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AgenticSupportGuide.Api.Tests" />
  </ItemGroup>

</Project>
