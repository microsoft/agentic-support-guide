# ============================================================================
# agentic-support-guide - Terraform variables
#
# HOW TO USE:
#   1. In VS Code, right-click this file and pick "Copy" -> paste as
#      terraform.tfvars in the same folder (or from a terminal:
#      `Copy-Item terraform.tfvars.example terraform.tfvars`).
#   2. Open terraform.tfvars in VS Code and edit the values below.
#   3. Save. `terraform.tfvars` is gitignored; this .example file is tracked.
# ============================================================================

# ---- REQUIRED ---------------------------------------------------------------

# Azure region. There is no default - Terraform will prompt if this is unset.
# Model, SKU, and quota availability is region-dependent. Common choices:
#   westus3, eastus2, swedencentral
location = "westus3"


# ---- Resource naming --------------------------------------------------------

resource_group_name = "rg-agentic-support-guide"


# ---- Model deployment -------------------------------------------------------
# The values below are safe defaults for a demo. Change them in this file
# rather than passing `-var` on the CLI.
#
# Model retirement schedule:
# https://learn.microsoft.com/azure/ai-services/openai/concepts/model-retirements

model_name    = "gpt-4.1-mini"
model_version = "2025-04-14"

# DataZoneStandard keeps inference traffic inside a single Azure data zone
# (US or EU). Alternatives: Standard, GlobalStandard, DataZoneBatch.
model_sku_name = "DataZoneStandard"

# Deployment capacity in thousands of tokens per minute. Requires quota.
#
# 10 suits a single developer. For a cohort raise it: each recommendation is
# four model calls, and at 10 only 2 of 15 concurrent requests succeed - the
# rest return AGENT_PROVIDER_THROTTLING. At 300, 30 of 30 succeed.
# Check headroom first: az cognitiveservices usage list -l <region> -o table
model_capacity = 10
# judge_capacity  = 50    # Module 8 evaluation
# router_capacity = 100   # Module 5 routing


# ---- RBAC principal ---------------------------------------------------------
# Entra ID Object ID that will receive access to call the model deployment
# (role: Cognitive Services OpenAI User on the AI Services account).
#
# Leave empty ("") to grant access to WHOEVER RUNS `terraform apply` - that
# identity's Object ID is discovered automatically. That is the normal case
# for a single-developer demo.
#
# Set this to a specific Object ID when:
#   - a different colleague will run the demo,
#   - a backend service principal or CI runner will call the model.
#
# How to look up an Object ID:
#   Yours:              az ad signed-in-user show --query id -o tsv
#   Another user:       az ad user show --id someone@example.invalid --query id -o tsv
#   Service principal:  az ad sp show --id <app-id> --query id -o tsv

principal_id = ""


# ---- API authentication -----------------------------------------------------
# The API sits behind App Service Easy Auth. Every endpoint except /api/health
# requires an Entra token, and each caller only sees the districts assigned to
# them here.
#
# Leave this true. Setting it false does not give you an open API for demos:
# the app refuses to run unauthenticated on App Service and returns 401 to
# everyone. If you cannot register an app yourself, run
# scripts/setup-api-auth.ps1 as someone who can and set api_client_id below.

enable_api_auth = true

# App registration for the API. Leave "" to let Terraform create one.
#
# Set this when the azuread provider fails to create it - a tenant with
# Continuous Access Evaluation returns `InvalidAuthenticationToken` on the
# provider's token but not on the CLI's. In that case run:
#   .\scripts\setup-api-auth.ps1
# and paste the client id it prints here.
api_client_id = ""

# Object IDs that may use every district and run the demo reset.
# Empty defaults to whoever runs `terraform apply`.
#
# Add the CI service principal here too, otherwise the post-deploy smoke test
# authenticates successfully and then gets 403 on every district:
#   az ad sp show --id <deploy-app-client-id> --query id -o tsv
facilitator_object_ids = []

# Which districts each learner may use. Districts are DIST-A, DIST-B and
# DIST-DEMO. An unlisted account can sign in but sees nothing, which is the
# intended default - a blanket grant would hand every account in the tenant
# access to every district.
#
#   district_assignments = {
#     "00000000-0000-0000-0000-000000000000" = ["DIST-A"]
#     "11111111-1111-1111-1111-111111111111" = ["DIST-A", "DIST-B"]
#   }
#
# Look up a learner's Object ID:
#   az ad user show --id someone@example.invalid --query id -o tsv
district_assignments = {}
