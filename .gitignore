# This repo has two tracks: Python under python/ and .NET under dotnet/, plus
# a shared TypeScript UI and Terraform.

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- Editors ---
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
.history/
*.swp
*~

# --- Python ---
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage/
htmlcov/
*.egg-info/

# --- .NET ---
bin/
obj/
.vs/
*.user
TestResults/
*.nupkg

# --- Node / Vite ---
node_modules/
dist/
build/
.vite/
*.local
*.tsbuildinfo

# --- Environment and secrets ---
.env
.env.*
!.env.example
# Terraform apply output and any stray run log can carry resource ids.
*.log

# Denylist local override (never commit real terms)
maintenance/denylist.local.txt

# --- Terraform ---
.terraform/
.terraform.lock.hcl.bak
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
!*.tfvars.example
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# --- Eval results (never commit) ---
evals/results/

# --- Screenshot redaction config (contains real tenant identifiers) ---
maintenance/portal_redact.config.json
!maintenance/portal_redact.config.example.json
# Generated capture bundle: inlines the config above, so it holds real values.
maintenance/.portal_redact.bundle.js

# --- Foundry bindings (env-specific, never commit) ---
.foundry/agent-bindings.local.json

# --- Generated knowledge export (Module 6) ---
evals/knowledge/
